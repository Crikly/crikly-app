# ============================================
# Crikly Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to git.
#
# NEXT_PUBLIC_ prefix = Available in browser (client components)
# No prefix = Server only (API routes, server components)
# ============================================

# ============================================
# Supabase
# ============================================
# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SECRET - server only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Stripe
# ============================================
# Stripe publishable key (safe to expose in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe secret key (SECRET - server only)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (SECRET - for webhook verification)
STRIPE_WEBHOOK_SECRET=

# ============================================
# Cron (Vercel)
# ============================================
# Shared secret guarding cron routes (BUG-13b). Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` with every cron invocation when this
# is set. SECRET - server only. Generate: openssl rand -hex 32
CRON_SECRET=

# ============================================
# Email (Resend)
# ============================================
# Resend API key for transactional emails (SECRET - server only)
RESEND_API_KEY=

# From address for transactional emails (defaults to bookings@crikly.app)
RESEND_FROM_EMAIL=bookings@crikly.app

# Ops alert recipient for payment_alerts rows (BUG-15): paid-but-no-spot,
# restore conflicts, poisoned webhook events. Fire-and-forget email via
# Resend; inert until set — Lasith sets it at promotion (same treatment as
# CRON_SECRET). Refunds stay manual via the Stripe Dashboard (policy B).
OPS_ALERT_EMAIL=

# ============================================
# Push Notifications (OneSignal)
# ============================================
# OneSignal App ID (safe to expose in browser)
ONESIGNAL_APP_ID=

# OneSignal REST API Key (SECRET - server only)
ONESIGNAL_REST_API_KEY=

# ============================================
# App Configuration
# ============================================
# Your application URL (e.g., https://crikly.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# ============================================
# Analytics (Google Analytics 4)
# ============================================
# GA4 Measurement ID (e.g., G-XXXXXXXXXX). Safe to expose in browser.
# Loaded via @next/third-parties. The GoogleAnalytics component only renders
# when this is set, so leave it BLANK in local dev and staging — set it ONLY
# in the Vercel Production environment so analytics fire in production alone.
NEXT_PUBLIC_GA_ID=

# ============================================
# Testing (E2E with Playwright)
# ============================================
# Credentials for the Test Coach used by e2e/fixtures/seed.ts and
# e2e/fixtures/auth.ts. Local dev: populate .env.local with a real coach
# account on the hosted dev project. CI: populate via GitHub Secrets with
# the same values. Never use real production user credentials here.
TEST_COACH_EMAIL=
TEST_COACH_PASSWORD=

# TEST-E2E-03: parent test user for the P7 RBAC negative-path spec (T7.3).
# Optional — when unset, seed.ts skips parent provisioning and T7.3 skips
# with its recorded reason. Set both locally and in CI Secrets to run it.
TEST_PARENT_EMAIL=
TEST_PARENT_PASSWORD=

# ============================================
# Google OAuth — LOCAL Supabase auth testing
# ============================================
# Read by the Supabase CLI (supabase start) via env() substitution in
# supabase/config.toml → [auth.external.google]. NOT read by Next.js.
# The CLI resolves these from the shell environment (or --env-file), so
# export them before `supabase start` for local Google sign-in to work.
# Create an OAuth 2.0 Client ID in Google Cloud and authorise the local
# callback: http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Feature Flags
# ============================================
# Gates the authenticated coach app. When not 'true', authenticated app
# routes are blocked by src/proxy.ts (pre-go-live lockdown).
# Local dev: set to 'true' to exercise the full coach app.
NEXT_PUBLIC_COACH_APP_LIVE=
